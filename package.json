{
  "name": "musicbot",
  "private": true,
  "version": "1.0.0",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "start": "node index.ts",
    "dev": "node scripts/dev.ts",
    "cmddeploy": "node scripts/deploy-commands.ts",
    "install:bgutil": "node scripts/install-bgutil.ts",
    "update:bgutil": "node scripts/install-bgutil.ts --update",
    "install:dashboard": "pnpm --dir dashboard/client run build",
    "build:dashboard": "pnpm --dir dashboard/client run build",
    "dev:dashboard": "pnpm --dir dashboard/client run dev",
    "update:ytdlp": "node scripts/update-ytdlp.ts",
    "update:models": "node scripts/refresh-ai-models.ts",
    "test": "node --check index.ts && node --test \"test/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "node scripts/setup-config.ts && node scripts/install-ffmpeg.ts && node scripts/update-ytdlp.ts",
    "install:ffmpeg": "node scripts/install-ffmpeg.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "chalk": "^4.1.2",
    "cors": "^2.8.6",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "gpt-tokenizer": "^4.0.0",
    "ipaddr.js": "^2.5.0",
    "korean-lunar-calendar": "^0.4.0",
    "yaml": "^2.9.1",
    "youtube-dl-exec": "^3.1.15",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22.18.0 <23 || >=24.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
