{
  "name": "musicbot",
  "private": true,
  "version": "1.0.0",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node scripts/dev.ts",
    "cmddeploy": "node scripts/deploy-commands.ts",
    "install:bgutil": "node scripts/install-bgutil.ts",
    "update:bgutil": "node scripts/install-bgutil.ts",
    "install:dashboard": "pnpm --dir dashboard run build",
    "build:dashboard": "pnpm --dir dashboard run build",
    "dev:dashboard": "pnpm --dir dashboard run dev",
    "update:ytdlp": "node scripts/update-ytdlp.ts",
    "update:models": "node scripts/refresh-ai-models.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/**/*.test.ts\" && node scripts/lcov-relative.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "node scripts/setup-config.ts && node scripts/install-ffmpeg.ts && node scripts/update-ytdlp.ts",
    "install:ffmpeg": "node scripts/install-ffmpeg.ts",
    "typecheck": "tsc -p . && tsc -p test/dashboard/client && pnpm --dir dashboard run typecheck"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "discord.js": "^14.27.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "gpt-tokenizer": "^4.0.0",
    "ipaddr.js": "^2.5.0",
    "korean-lunar-calendar": "^0.4.0",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "youtube-dl-exec": "^3.1.15",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/fontkit": "^2.0.9",
    "@types/node": "catalog:",
    "@types/subset-font": "^2.3.0",
    "@vue/compiler-sfc": "3.5.43",
    "cmu-pronouncing-dictionary": "3.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "fontkit": "^2.0.4",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.8",
    "subset-font": "^2.9.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.70.1"
  }
}
