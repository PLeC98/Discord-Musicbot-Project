{
  "name": "musicbot",
  "private": true,
  "version": "0.9.0",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/check-bot-stopped.ts",
    "start": "node scripts/launch.ts",
    "backup": "node scripts/backup.ts",
    "dev": "node scripts/dev.ts",
    "commands": "node scripts/deploy-commands.ts",
    "install:bgutil": "node scripts/install-bgutil.ts",
    "update:bgutil": "node scripts/install-bgutil.ts",
    "build:dashboard": "pnpm --dir dashboard run build",
    "dev:dashboard": "pnpm --dir dashboard run dev",
    "update:ytdlp": "node scripts/update-ytdlp.ts",
    "update:models": "node scripts/refresh-ai-models.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:coverage": "node -e \"require('node:fs').mkdirSync('coverage', { recursive: true })\" && node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/**/*.test.ts\" && node scripts/lcov-relative.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "postinstall": "node scripts/setup-config.ts",
    "install:ffmpeg": "node scripts/install-ffmpeg.ts",
    "typecheck": "tsc -p . && tsc -p test/dashboard/client && pnpm --dir dashboard run typecheck"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@fontsource-variable/google-sans-flex": "catalog:",
    "@material/material-color-utilities": "catalog:",
    "@napi-rs/canvas": "^1.1.1",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "discord.js": "^14.28.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "express-session": "^1.19.0",
    "file-type": "^22.3.0",
    "gpt-tokenizer": "^4.1.0",
    "ipaddr.js": "^2.5.0",
    "korean-lunar-calendar": "^0.4.0",
    "libopus-wasm": "0.4.1",
    "maxmind": "^5.0.8",
    "music-metadata": "^12.3.5",
    "pretendard": "catalog:",
    "sharp": "^0.35.5",
    "ua-parser-js": "^2.0.10",
    "youtubei.js": "18.3.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "^24.22.3 || >=26.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/fontkit": "^2.0.9",
    "@types/node": "catalog:",
    "@types/subset-font": "^2.3.0",
    "@vue/compiler-sfc": "3.5.45",
    "cmu-pronouncing-dictionary": "3.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "fontkit": "^2.0.4",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "subset-font": "^2.9.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.1",
    "wawoff2": "^2.0.1"
  }
}
