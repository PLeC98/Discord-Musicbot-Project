# 자세한 설명은 `docs/env.md`를 참고하시기 바랍니다.
#
# 여기에는 봇이 켜지기 전에 있어야 하는 값만 있습니다.
# 이곳에 없는 대부분의 봇 설정은 대시보드의 운영자 패널에서 설정합니다.

# 라이선스(AGPL)용 저장소 URL
SOURCE_REPO_URL=     # 코드 수정이 없다면 공란. 코드를 수정해 운영한다면 수정본의 소스를 공개한 저장소 URL을 입력하세요. /license와 새 서버 안내의 링크 버튼이 이 주소를 가리킵니다.

# 필수 설정 값
DISCORD_TOKEN=          # 봇 토큰
CLIENT_SECRET=          # 클라이언트 시크릿
OWNER_ID=               # 봇 운영자의 Discord 사용자 ID (Snowflake ID)

# 대시보드
DASHBOARD_PORT=33333     # 대시보드 포트
DASHBOARD_URL=           # 디스코드 OAuth 콜백에 쓰는, 브라우저 주소창에 입력하는 주소. (http://localhost:[포트 번호])와 다르면 필수

# 로그 (로그 레벨: trace < debug < info < warn < error < fatal)
LOG_LEVEL=info           # 설정값 이상의 로그만 기록합니다 (예: info면 info, warn, error, fatal)
LOG_CONSOLE_LEVEL=       # 터미널 표시값 설정. LOG_LEVEL과 같거나 높아야 합니다. 비우면 LOG_LEVEL.
LOG_FILE_ENABLED=true    # false로 하면 로그를 파일로 저장하지 않습니다. 대시보드의 로그 파일 보기(지난 기록)도 꺼집니다.
LOG_FILE=logs/bot.log    # 로그 파일 저장 경로. 상대경로는 프로젝트 루트 기준.
LOG_FILE_MAX_MB=20       # 용량이 설정값을 넘으면 로그 파일을 분리합니다.
LOG_FILE_KEEP=5          # 로그 파일 보존 개수. 넘으면 오래된 것부터 지웁니다. (기본값: 5, 0이면 삭제 없음)

# -- [고급 설정] ------------------------------------------------

# 명령어 제한 배포
GUILD_ID=               # 서버 ID. 미설정 시 전역 배포. (테스트 서버에서만 사용할 경우 사용)

# 대시보드 고급 설정 (`docs/dashboard-network.md` 참고)
DASHBOARD_HOST=            # 대시보드를 열 주소
DASHBOARD_TRUST_PROXY=     # 추가로 신뢰할 원격 프록시의 공인 IP
DASHBOARD_ALLOW_PLAINTEXT= # 공인 IP를 내부망으로 쓰는 환경처럼 위험을 감수할 때만 켜세요.
DASHBOARD_TLS_CERT=        # SSL 인증서 파일 경로. 비우면 certs/cert.pem.
DASHBOARD_TLS_KEY=         # SSL 인증서 키 파일 경로. 비우면 certs/key.pem.

# ffmpeg
FFMPEG_PATH=            # 실행 파일 경로

# -- [자동 생성] 기타 시크릿 키 ---------------------------------
#   `install` 과정에서 자동 생성되어 채워지는 값입니다.
#   값이 변경되면 암호화된 기존 데이터를 사용하지 못하게 되며, 대시보드 로그인이 풀립니다.
#   실수로 삭제했거나, 채워지지 않았거나 등의 사유로 직접 생성이 필요하면 설명 파일을 참고하세요.
SECRETS_KEY=            # 비밀값 암호화 키
SESSION_SECRET=         # 세션 쿠키 서명 시크릿
