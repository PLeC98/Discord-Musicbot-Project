# Your Repository
SOURCE_REPO_URL=https://github.com/YOUR_GITHUB_USERNAME/YOUR_REPOSITORY_NAME        # Your Repository

# Discord Bot Configuration
DISCORD_TOKEN=
CLIENT_ID=
CLIENT_SECRET=
GUILD_ID=

# Spotify API Configuration
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Bot Settings (Optional - defaults will be used if not set)
EMBED_COLOR="#2743D2"
SUPPORT_SERVER=
WEBSITE=

# Sharding Settings (For bots with 1000+ servers)
# Leave as 'auto' for automatic configuration
TOTAL_SHARDS=auto
SHARD_LIST=auto
SHARD_MODE=process
SHARD_RESPAWN=true
SHARD_SPAWN_DELAY=5500
SHARD_SPAWN_TIMEOUT=30000

# YouTube Cookie Settings (Fix for bot detection errors)
# Method 1: Use browser cookies (recommended - easier to keep up-to-date)
# Options: chrome, firefox, edge, safari
# Example: COOKIES_FROM_BROWSER=chrome
COOKIES_FROM_BROWSER=

# Method 2: Use cookies.txt file
# Export cookies from browser extension and save as cookies.txt
# Example: COOKIES_FILE=./cookies.txt
COOKIES_FILE=

# Cache Settings
CACHE_MAX_SIZE_MB=1024           # 캐시 최대 용량 (MB)
CACHE_MAX_FILES=500              # 캐시 최대 파일 수
CACHE_MIN_FREE_DISK_MB=2048      # 디스크 최소 여유 공간 (MB) — 이 미만이면 강제 퇴거
CACHE_EVICT_INTERVAL_HOURS=4     # 주기적 정리 간격 (시간)

# Leave Delay Settings
LEAVE_DELAY_QUEUE_EMPTY_SECONDS=600   # 대기열 소진 후 채널 나가기까지 대기 시간 (초)
LEAVE_DELAY_ALONE_SECONDS=120        # 채널에 혼자 남았을 때 나가기까지 대기 시간 (초)

# Voice Channel Status Settings
VOICE_PLAYING_PREFIX="📻 "
VOICE_PAUSED_PREFIX="⏸ "
VOICE_IDLE_STATUS="(ᴗ˳ᴗ)ᶻ𝗓𐰁"

# Dashboard
DASHBOARD_PORT=33333
DASHBOARD_URL=
OWNER_ID=
SESSION_SECRET=