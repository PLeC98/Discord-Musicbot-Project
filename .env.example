# Repository URL for license (AGPL)
SOURCE_REPO_URL=                # 코드 수정이 없다면 공란으로 두세요. 코드 수정이 있다면  수정본의 소스 데이터를 공개하여 해당 데이터에 접근할 수 있는 URL을 이곳에 입력하세요. - 공식적으로 지원하는 주소는 Github 주소 뿐입니다. 다른 Git 저장소를 사용하는 경우, `command/license.js`의 코드를 적절히 수정하세요.

# 디스코드 봇 설정
DISCORD_TOKEN=                  # 봇 토큰을 입력하세요. (https://discord.com/developers/applications에서 발급)
CLIENT_ID=                      # 클라이언트 ID를 입력하세요. (https://discord.com/developers/applications에서 발급)
CLIENT_SECRET=                  # 클라이언트 시크릿을 입력하세요. (https://discord.com/developers/applications에서 발급)
GUILD_ID=                       # 길드 ID를 입력하세요. (선택 사항 - 테스트 서버에서만 사용할 경우 권장)

# 스포티파이 API 설정
SPOTIFY_CLIENT_ID=              # Spotify 클라이언트 ID를 입력하세요. (https://developer.spotify.com/dashboard/applications에서 발급)
SPOTIFY_CLIENT_SECRET=          # Spotify 클라이언트 시크릿을 입력하세요. (https://developer.spotify.com/dashboard/applications에서 발급)

# 봇 설정 (Optional - defaults will be used if not set)
EMBED_COLOR="#2743D2"
SUPPORT_SERVER=
WEBSITE=

# Sharding Settings (For bots with 1000+ servers)
# Leave as 'auto' for automatic configuration
TOTAL_SHARDS=auto
SHARD_LIST=auto
SHARD_MODE=process
SHARD_RESPAWN=true
SHARD_SPAWN_DELAY=5500
SHARD_SPAWN_TIMEOUT=30000

# YouTube Cookie Settings (Fix for bot detection errors)
# Method 1: Use browser cookies (recommended - easier to keep up-to-date)
# Options: chrome, firefox, edge, safari
# Example: COOKIES_FROM_BROWSER=chrome
COOKIES_FROM_BROWSER=

# Method 2: Use cookies.txt file
# Export cookies from browser extension and save as cookies.txt
# Example: COOKIES_FILE=./cookies.txt
COOKIES_FILE=

# Cache Settings
CACHE_MAX_SIZE_MB=1024           # 캐시 최대 용량 (MB)
CACHE_MAX_FILES=500              # 캐시 최대 파일 수
CACHE_MIN_FREE_DISK_MB=2048      # 디스크 최소 여유 공간 (MB) — 이 미만이면 강제 퇴거
CACHE_EVICT_INTERVAL_HOURS=4     # 주기적 정리 간격 (시간)

# 봇 퇴장 지연 설정
LEAVE_DELAY_QUEUE_EMPTY_SECONDS=600   # 대기열 소진 후 채널 나가기까지 대기 시간 (초)
LEAVE_DELAY_ALONE_SECONDS=120         # 채널에 혼자 남았을 때 나가기까지 대기 시간 (초)

# 음성 채널 상태 메세지 설정
VOICE_PLAYING_PREFIX="📻 "           #
VOICE_PAUSED_PREFIX="⏸ "             #
VOICE_IDLE_STATUS="(ᴗ˳ᴗ)ᶻ𝗓𐰁"

# Dashboard
DASHBOARD_PORT=33333
DASHBOARD_URL=
OWNER_ID=
SESSION_SECRET=