# ══════════════════════════════════════════════════════════════════════════
#  설정 템플릿 — 이 파일을 .env 로 복사한 뒤 값을 채워서 사용하세요.
# ══════════════════════════════════════════════════════════════════════════
#
# 여기에는 봇이 켜지기 전에 있어야 하는 값만 있습니다.
#   예: 봇 토큰, 시크릿 키, 대시보드 주소, yt-dlp 및 ffmpeg 설치 및 실행, 로그 설정
# 대기열, 유튜브 클라이언트 및 쿠키, SponsorBlock, 음성 상태 문구, 캐시, 요청 제한 등이나
# Spotify, Last.fm, ListenBrainz 등 외부 API 키는 대시보드의 운영자 패널 → 설정 탭에서 설정합니다.
#   (settings.db 에 저장되며, 키는 암호화됩니다.)
# 과거 개발 초기 버전에 있던 일부 값은 `.env`에 있어도 무시됩니다. 대시보드 설정에서 다시 설정하세요.

# 라이선스(AGPL)용 저장소 URL
SOURCE_REPO_URL=     # 코드 수정이 없다면 공란으로 두세요. 코드를 수정해 운영한다면 수정본의 소스를 공개한 URL을 입력하세요. - 공식적으로 지원하는 주소는 Github 주소 뿐입니다. 다른 Git 저장소를 사용하는 경우, `src/discord/commands/license.ts`의 코드를 적절히 수정하세요.

# 디스코드 봇 설정
DISCORD_TOKEN=          # [필수] 봇 토큰
CLIENT_ID=              # [필수] 클라이언트 ID
CLIENT_SECRET=          # [필수] 클라이언트 시크릿 (대시보드 로그인. 개발자 포털 OAuth2 → Client Secret)
GUILD_ID=               # 서버 ID (테스트 서버에서만 사용할 경우. 비우면 전역 커맨드로 배포)

# 대시보드
DASHBOARD_PORT=33333     # 대시보드 포트
DASHBOARD_HOST=          # 접속 허용 주소. 비우면 127.0.0.1 (이 기기 전용). 다른 기기에서 접속하려면 0.0.0.0 (보안을 위해 HTTPS 프록시 뒤에 두세요).
DASHBOARD_URL=           # 브라우저에서 접속하는 주소. Discord OAuth 콜백에 쓰이므로 기본값(http://localhost:[포트 번호])과 다르면 반드시 설정
OWNER_ID=                # [준필수] 봇 운영자의 Discord 사용자 ID (Snowflake ID) - 대시보드 운영자 패널의 접근 권한과 일부 명령어 사용이 가능합니다. 봇의 세세한 설정을 위해서는 필수입니다.

# 기타 시크릿 키
#   .env가 없다면, `pnpm install`이나 봇 기동 시 자동으로 생성합니다.
#   직접 생성하기:
#     SECRETS_KEY: `node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"`
#     SESSION_SECRET: `node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"`
SECRETS_KEY=            # [필수] 비밀값 암호화 키 (32바이트 base64 문자열) - 대시보드에 저장하는 API 키나 쿠키 같은 민감 정보를 암호화하는데 쓰입니다. 이 값이 변경되면 기존의 암호화된 데이터를 사용할 수 없습니다. 해당 데이터를 사용하려면 기존의 값을 넣어야만 합니다.
SESSION_SECRET=         # 세션 쿠키 서명 시크릿 (64자 이상의 랜덤 문자열 권장) - 비우면 기동마다 랜덤으로 생성하며, 재시작 시 대시보드 로그인이 풀려 매번 재 로그인을 요구하게 됩니다.

# ffmpeg 실행 파일 경로 - 비워두면 자동 탐색 / 번들 바이너리 경로 → ffmpeg PATH (환경 변수)
FFMPEG_PATH=            # macOS는 번들 바이너리를 제공하지 않으므로 `brew install ffmpeg` 후 PATH에 두거나 여기서 지정하세요 (예시: FFMPEG_PATH=/usr/bin/ffmpeg)

# 내려받을 ffmpeg 릴리스 태그. 비우면 고정된 기본값을 씁니다.
#   각 달의 마지막 빌드를 사용하는 것을 강력히 권장합니다.
#   그 외 autobuild는 2주 뒤 삭제되어 404 오류가 발생합니다.
#   목록: https://github.com/BtbN/FFmpeg-Builds/tags (월말 빌드는 2년간 보존)
#   바꾼 뒤 `pnpm run install:ffmpeg --force`로 다시 받습니다.
FFMPEG_RELEASE=         # 예시: FFMPEG_RELEASE=autobuild-2026-08-31-13-27

# yt-dlp 버전
#   채널: nightly(기본. yt-dlp 권장값. 각 사이트의 변화를 제일 빠르게 따라감), stable(한 달 정도에 한번 릴리스), master(매 변경마다 릴리스. 불안정할 수 있음.)
#   버전: 입력한 버전으로 고정합니다. 비우면 해당 채널의 최신 버전을 사용합니다.
#     목록: https://github.com/yt-dlp/yt-dlp-nightly-builds/releases
#       (stable 은 yt-dlp/yt-dlp, master 는 yt-dlp/yt-dlp-master-builds)
#   일일 업데이트 확인 및 자동 업데이트:
#     auto  : 새 버전으로 바로 교체함 (하던 작업이 있으면 그 작업은 구버전을 사용)
#     notify: 로그로 알림만 함
#     off   : 확인하지 않음
#   `pnpm run update:ytdlp`는 이 설정과 상관없이 목표 버전으로 받습니다.
YTDLP_CHANNEL=           # 예시: YTDLP_CHANNEL=stable
YTDLP_VERSION=           # 예시: YTDLP_VERSION=2026.08.19
YTDLP_UPDATE=            # 예시: YTDLP_UPDATE=notify

# bgutil(POToken 공급자) 버전
#   버전: bgutil-ytdlp-pot-provider의 태그. 비우면 기본값으로 설정된 버전을 사용합니다.
#     목록: https://github.com/Brainicism/bgutil-ytdlp-pot-provider/tags
#   POToken 서버의 사용 여부는 설정 탭의 "POToken 서버 쓰기"로 설정합니다.
#   설정 변경 후, 봇을 끄고 `pnpm run update:bgutil`로 해당 버전으로 변경하세요.
BGUTIL_VERSION=          # 예시: BGUTIL_VERSION=2.0.2

# 로그 (로그 레벨: trace < debug < info < warn < error < fatal)
LOG_LEVEL=info           # 설정값 이상의 로그만 기록합니다 (예: info면 info·warn·error·fatal)
LOG_CONSOLE_LEVEL=       # 터미널 표시값에만 적용되며, LOG_LEVEL보다 높은 값이어야 합니다. 비우면 LOG_LEVEL을 따릅니다.
LOG_FILE_ENABLED=true    # false로 하면 로그를 파일로 저장하지 않습니다. 대시보드의 로그 파일 보기(지난 기록)도 꺼집니다.
LOG_FILE=logs/bot.log    # 로그 파일 저장 경로. 상대경로는 프로젝트 루트 기준.
LOG_FILE_MAX_MB=20       # 이 크기가 되면 기존 내용을 별개 파일로 분리합니다. (기본값: 20, 0이면 단일 파일로 작성)
LOG_FILE_KEEP=5          # 로그 파일을 몇개까지 보존할지. 초과시 오래된 것 부터 지웁니다. (기본값: 5, 0이면 삭제 없음)
