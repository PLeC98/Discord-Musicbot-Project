# ══════════════════════════════════════════════════════════════════════════
#  설정 템플릿 — 이 파일을 .env 로 복사한 뒤 값을 채워서 사용하세요.
# ══════════════════════════════════════════════════════════════════════════

# 라이선스(AGPL)용 저장소 URL
SOURCE_REPO_URL=                        # 코드 수정이 없다면 공란으로 두세요. 코드를 수정해 운영한다면 수정본의 소스를 공개한 URL을 입력하세요. - 공식적으로 지원하는 주소는 Github 주소 뿐입니다. 다른 Git 저장소를 사용하는 경우, `command/license.js`의 코드를 적절히 수정하세요.

# 디스코드 봇 설정
DISCORD_TOKEN=                          # [필수] 봇 토큰 (https://discord.com/developers/applications에서 발급)
CLIENT_ID=                              # [필수] 클라이언트 ID (https://discord.com/developers/applications에서 발급)
CLIENT_SECRET=                          # 클라이언트 시크릿 - 대시보드 Discord 로그인(OAuth)에 사용. 비우면 대시보드 로그인만 비활성화됩니다.
GUILD_ID=                               # 길드 ID (선택 - 테스트 서버에서만 사용할 경우 권장. 비우면 전역 커맨드로 배포)

# 스포티파이 API 설정 (비우면 Spotify 검색/링크 기능만 비활성화)
SPOTIFY_CLIENT_ID=                      # Spotify 클라이언트 ID (https://developer.spotify.com/dashboard/applications에서 발급)
SPOTIFY_CLIENT_SECRET=                  # Spotify 클라이언트 시크릿 (https://developer.spotify.com/dashboard/applications에서 발급)

# 봇 설정
EMBED_COLOR="#2743D2"                 # 임베드 색상
SUPPORT_SERVER=                         # 지원 서버 초대 링크 (선택)
WEBSITE=                                # 봇 웹사이트 주소 (선택 - 비우면 /help에서 링크 생략)

# 샤딩 설정 - `npm run shard` (1000+ 서버 규모) 사용 시에만 필요
# 일반 실행(`npm start`)에서는 무시됩니다.
# TOTAL_SHARDS: 'auto' 권장 (Discord가 권장 샤드 수를 자동 계산).
#               숫자로 직접 지정할 경우 권장값은 올림(서버 수 ÷ 1000)
TOTAL_SHARDS=auto
SHARD_LIST=auto                         # 스폰할 샤드 목록 ('auto' = 전체)
SHARD_MODE=process                      # 'process' (권장, 안정적) 또는 'worker' (실험적, 메모리 절약)
SHARD_RESPAWN=true                      # 크래시된 샤드 자동 재시작
SHARD_SPAWN_DELAY=5500                  # 샤드 간 스폰 간격 (ms) - Discord 권장 5000-5500ms
SHARD_SPAWN_TIMEOUT=30000               # 샤드 ready 대기 타임아웃 (ms)

# 유튜브 봇 감지 차단 우회 설정
# 방식 1: bgutil-ytdlp-pot-provider 사용 (권장 - 설정 할 필요 없으나, 별도 설치 필요. README 참고.)

# 방식 2: 브라우저 쿠키 사용
# 옵션: chrome, firefox, edge, safari
# 예시: COOKIES_FROM_BROWSER=chrome
COOKIES_FROM_BROWSER=

# 방식 3: cookies.txt 파일 사용
# 브라우저 확장 프로그램에서 쿠키 내보내기 및 cookies.txt로 저장
# 예시: COOKIES_FILE=./cookies.txt
COOKIES_FILE=

# 오디오 캐시 설정
CACHE_MAX_SIZE_MB=1024                 # 캐시 최대 용량 (MB)
CACHE_MAX_FILES=500                    # 캐시 최대 파일 수
CACHE_MIN_FREE_DISK_MB=2048            # 디스크 최소 여유 공간 (MB) - 이 미만이면 강제 퇴거
CACHE_EVICT_INTERVAL_HOURS=4           # 주기적 정리 간격 (시간)

# 봇 퇴장 지연 설정
LEAVE_DELAY_QUEUE_EMPTY_SECONDS=600    # 대기열 소진 후 채널 나가기까지 대기 시간 (초)
LEAVE_DELAY_ALONE_SECONDS=120          # 채널에 혼자 남았을 때 나가기까지 대기 시간 (초)

# SponsorBlock 구간 자동 스킵 (세그먼트 데이터: sponsor.ajay.app, CC BY-NC-SA 4.0)
SPONSORBLOCK_ENABLED=true              # false면 기능 전체 비활성(API 호출·캐싱 없음). 상업적 이용 시 false 권장(데이터 라이선스가 비상업)
SPONSORBLOCK_CATEGORIES=music_offtopic,intro,outro   # 서버별 미설정 시 기본 스킵 카테고리 (추가 가능: sponsor,selfpromo,interaction,preview,hook,filler)
SPONSORBLOCK_TIMEOUT_MS=1000           # 조회 타임아웃(ms). 초과 시 캐시 폴백 또는 스킵 없이 재생
SPONSORBLOCK_API_BASE=https://sponsor.ajay.app   # 미러/셀프호스트 시 변경
SPONSORBLOCK_HASH_PREFIX=5             # 프라이버시 해시 프리픽스 길이(4~32). 짧을수록 익명성↑·응답↑

# 음성 채널 상태 메세지 설정 (비우면 접두사/문구 없음)
VOICE_PLAYING_PREFIX="📻 "            # 재생 중 접두사
VOICE_PAUSED_PREFIX="⏸ "             # 일시정지 중 접두사
VOICE_IDLE_STATUS="(ᴗ˳ᴗ)ᶻ𝗓𐰁"

# 대시보드
DASHBOARD_PORT=33333                  # 대시보드 포트
DASHBOARD_URL=                        # 외부 공개 주소 (리버스 프록시 사용 시 설정 필요. 비우면 http://localhost:[포트 번호])
OWNER_ID=                             # 관리자 대시보드에 접근할 Discord 사용자 ID (비우면 관리자 기능 접근 불가)
SESSION_SECRET=                       # 세션 쿠키 서명 비밀 - 최소 64자 이상 랜덤 문자열 권장 (비우면 기동마다 랜덤 생성 = 재시작 시 대시보드 로그인 풀림)