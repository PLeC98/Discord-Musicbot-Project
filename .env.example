# 자세한 설명은 `docs/env.md`를 참고하시기 바랍니다.
# 대부분의 봇 설정은 대시보드의 운영자 패널에서 설정합니다.

# -- [라이선스] ------------------------------------------------------

# 저장소 URL - AGPL v3 라이선스
#   코드에 수정을 가한 경우 반드시 코드를 공개하고, 아래에 해당 저장소의 URL을 입력하십시오.
#   지원하는 링크는 GitHub뿐입니다.
#   그 외의 Git 저장소를 사용하는 경우, `src/discord/commands/license.ts` 파일을 수정하세요.
#   코드 수정 없이 사용하는 경우, 이 항목을 비워두십시오.
SOURCE_REPO_URL=

# -- [필수 설정] -------------------------------------------------------

# 봇
DISCORD_TOKEN=          # 봇 토큰
CLIENT_SECRET=          # 클라이언트 시크릿

# 대시보드
DASHBOARD_PORT=33333     # 대시보드 포트
DASHBOARD_URL=           # 디스코드 OAuth 콜백에 쓰는, 브라우저 주소창에 입력하는 주소. (http://localhost:[포트 번호])와 다르면 필수

# -- [선택 / 고급 설정] `docs/env.md` 참고 -----------------------------

# ffmpeg
FFMPEG_PATH=            # 실행 파일 경로

# 로그
LOG_LANGUAGE=           # 로그 출력 언어. 미설정/미지원 언어 설정 시 OS 언어 사용. OS 언어가 지원되지 않으면 한국어로 출력.
LOG_FILE_ENABLED=true   # false로 하면 로그를 파일로 저장하지 않습니다. 대시보드의 로그 파일 보기(지난 기록)도 꺼집니다.
LOG_FILE=logs/bot.log   # 로그 파일 저장 경로. 상대경로는 프로젝트 루트 기준.
LOG_FILE_MAX_MB=20      # 용량이 설정값을 넘으면 로그 파일을 분리합니다.
LOG_FILE_KEEP=5         # 로그 파일 보존 개수. 넘으면 오래된 것부터 지웁니다. (기본값: 5, 0이면 삭제 없음)

# 봇 운영자
OWNER_ID=               # 비우면 디스코드 앱 소유자(혹은 팀 소유자). 직접 정할 때만 사용자 ID를 쉼표로 구분해 입력

# 대시보드 (`docs/dashboard-network.md` 참고)
DASHBOARD_TLS_CERT=        # SSL 인증서 파일 경로. 비우면 certs/cert.pem.
DASHBOARD_TLS_KEY=         # SSL 인증서 키 파일 경로. 비우면 certs/key.pem.
DASHBOARD_TRUST_PROXY=     # 추가로 신뢰할 원격 프록시의 공인 IP
DASHBOARD_HOST=            # 대시보드를 열 주소
DASHBOARD_ALLOW_PLAINTEXT= # 공인 IP를 내부망으로 쓰는 환경처럼 위험을 감수할 때만 켜세요.

# -- [개발 및 테스트용] ------------------------------------------------

# 지정 서버에만 명령어 배포 (미설정 시 명령어 전역 배포)
GUILD_ID=               # 서버 ID

# -- [자동 생성] 시크릿 키 ---------------------------------------------

# 봇 설치 과정에서 자동 생성되는 값이며, 다음을 위해 사용됩니다:
#   - DB 내 암호화된 데이터: 변경되면 DB 내 API 키, 쿠키 등의 값을 불러오지 못합니다.
#   - 대시보드 로그인: 변경되면 기존 로그인 세션이 모두 풀립니다.
# 실수로 삭제했거나, 채워지지 않을 경우 설명 파일을 참고하여 수동으로 생성하세요.
SECRETS_KEY=
