# ══════════════════════════════════════════════════════════════════════════
#  설정 템플릿 — 이 파일을 .env 로 복사한 뒤 값을 채워서 사용하세요.
# ══════════════════════════════════════════════════════════════════════════

# 라이선스(AGPL)용 저장소 URL
SOURCE_REPO_URL=     # 코드 수정이 없다면 공란으로 두세요. 코드를 수정해 운영한다면 수정본의 소스를 공개한 URL을 입력하세요. - 공식적으로 지원하는 주소는 Github 주소 뿐입니다. 다른 Git 저장소를 사용하는 경우, `commands/license.ts`의 코드를 적절히 수정하세요.

# 디스코드 봇 설정
DISCORD_TOKEN=          # [필수] 봇 토큰
CLIENT_ID=              # [필수] 클라이언트 ID
CLIENT_SECRET=          # 클라이언트 시크릿 (비우면 대시보드 로그인이 비활성화됩니다)
GUILD_ID=               # 서버 ID (테스트 서버에서만 사용할 경우 권장. 비우면 전역 커맨드로 배포)

# 스포티파이 API 설정 (비우면 Spotify 기능 일부가 작동하지 않음)
SPOTIFY_CLIENT_ID=        # Spotify 클라이언트 ID
SPOTIFY_CLIENT_SECRET=    # Spotify 클라이언트 시크릿

# 자동재생 소스 (config/genres.yaml 에서 해당 소스를 쓸 때만 필요)
# 키가 없으면 그 소스만 빠지고 나머지로 돕니다. 장르에 쓸 수 있는 소스가 하나도 안 남으면 기동이 멈춥니다.
# Last.fm은 발급할 시 API 키와 시크릿을 주지만, 시크릿은 조회에는 불필요하여 API만 있으면 됩니다.
LASTFM_API_KEY=            # Last.fm API 키 (https://www.last.fm/api/account/create)
LISTENBRAINZ_TOKEN=        # ListenBrainz 사용자 토큰 (https://listenbrainz.org/settings/)

# 봇 설정
EMBED_COLOR="#2743D2"     # 임베드 색상
SUPPORT_SERVER=             # 지원 서버 초대 링크
WEBSITE=                    # 봇 웹사이트 주소 (비우면 /help에서 링크 생략)

# 대기열 상한 — 서버 하나의 대기열에 들어갈 수 있는 곡 수 (재생 중인 곡은 세지 않음)
#   넘치는 곡은 넣지 않고 몇 곡을 뺐는지 알립니다. 0이면 제한하지 않고, 0이 아니면 25 이상이어야 합니다.
#   곡이 수천 개면 셔플처럼 대기열 전체를 다시 쓰는 조작 동안 봇 전체가(다른 서버의 재생까지) 잠깐 멈출 수 있습니다.
#   1,000곡 안쪽을 권장합니다.
QUEUE_MAX_TRACKS=250

# 봇 퇴장 지연 설정
LEAVE_DELAY_QUEUE_EMPTY_SECONDS=600    # 대기열 소진 후 채널 나가기까지 대기 시간 (초)
LEAVE_DELAY_ALONE_SECONDS=120          # 채널에 혼자 남았을 때 나가기까지 대기 시간 (초)

# ffmpeg 실행 파일 경로 (비워두면 자동 탐색 / 번들 바이너리 → ffmpeg PATH)
FFMPEG_PATH=                           # macOS는 번들 바이너리를 제공하지 않으므로 `brew install ffmpeg` 후 PATH에 두거나 여기서 지정하세요 (예시: FFMPEG_PATH=/usr/bin/ffmpeg)

# 내려받을 ffmpeg 릴리스 (BtbN/FFmpeg-Builds의 태그). 비우면 고정된 기본값을 씁니다.
#   반드시 각 달의 마지막 빌드를 쓰세요 — 그 외 autobuild는 2주 뒤 삭제되어 내려받기가 404가 됩니다.
#   목록: https://github.com/BtbN/FFmpeg-Builds/releases (월말 빌드는 2년간 보존)
#   바꾼 뒤 `pnpm run install:ffmpeg --force`로 다시 받습니다.
FFMPEG_RELEASE=                        # 예시: FFMPEG_RELEASE=autobuild-2026-08-31-13-27

# 유튜브 클라이언트 경로
#   비워두면 yt-dlp의 기본값을 사용합니다.
#   여럿을 적을 시 앞에서부터 시도하며, 실패시 뒤의 것으로 폴백합니다
#   실패가 반복되면 봇의 실행 세션 동안 해당 클라이언트는 막힌 것으로 판단하여 건너뜁니다.
YTDLP_PLAYER_CLIENTS=       # 예시: YTDLP_PLAYER_CLIENTS=visionos,web_embedded,tv_embedded
YTDLP_CLIENT_WINDOW=5       # 최근 몇 번을 보고 판단할지
YTDLP_CLIENT_FAILS=3        # 그중 몇 번 실패하면 건너뛸지

# POToken 공급자 - 설치 별도 (README 참고)
# mweb, tv_simply 클라이언트 경로 사용시 필수
BGUTIL_ENABLED=false        # POToken 서버가 준비되어 있고 true로 설정하면 봇 기동시 POToken 서버를 같이 기동

# 쿠키 - 연령 제한 영상 인증
#   일반적인 영상은 쿠키 없이 재생하고, 연령 제한 영상에만 사용됩니다.
#   연령 인증이 된 계정의 쿠키여야 하며, 없으면 연령 제한 영상은 재생이 불가능합니다.
#   계정이 (일시적 혹은 영구적으로) 차단될 위험이 있습니다. 요청 빈도와 다운로드 양에 주의하고, 필요한 경우에만 사용하세요.

#   브라우저 이름을 적으면 그 브라우저에서 직접 가져오고, (chrome, firefox, edge, safari 등)
#   file 을 적으면 config/cookies.txt 를 씁니다. 비우면 쿠키를 쓰지 않습니다.
COOKIES_SOURCE=                        # chrome, firefox, edge, safari, file

# SponsorBlock 구간 자동 스킵 (세그먼트 데이터: sponsor.ajay.app, CC BY-NC-SA 4.0)
SPONSORBLOCK_ENABLED=true                          # false면 기능 전체 비활성(API 호출·캐싱 없음). 상업적 이용 시 false 권장(데이터 라이선스가 비상업)
SPONSORBLOCK_CATEGORIES=music_offtopic,intro,outro # 서버별 미설정 시 기본 스킵 카테고리 (추가 가능: sponsor,selfpromo,interaction,preview,hook,filler)
SPONSORBLOCK_TIMEOUT_MS=1000                       # 조회 타임아웃(ms). 초과 시 캐시 폴백 또는 스킵 없이 재생
SPONSORBLOCK_API_BASE=https://sponsor.ajay.app     # 미러/셀프호스트 시 변경
SPONSORBLOCK_HASH_PREFIX=5                         # 프라이버시 해시 프리픽스 길이(4~32). 짧을수록 익명성↑·응답↑

# 음성 채널 상태 메세지 설정 (비우면 접두사/문구 없음)
VOICE_PLAYING_PREFIX="📻 "      # 재생 중 접두사
VOICE_PAUSED_PREFIX="⏸ "        # 일시정지 중 접두사
VOICE_IDLE_STATUS="(ᴗ˳ᴗ)ᶻ𝗓𐰁"     # 대기 중 접두사

# 대시보드
DASHBOARD_PORT=33333     # 대시보드 포트
DASHBOARD_HOST=          # 접속 허용 주소. 비우면 127.0.0.1 (이 기기 전용). 다른 기기에서 접속하려면 0.0.0.0 - HTTPS 프록시 뒤에 두세요
DASHBOARD_URL=           # 브라우저에서 접속하는 주소. Discord OAuth 콜백에 쓰이므로 기본값(http://localhost:[포트 번호])과 다르면 반드시 설정
OWNER_ID=                # 봇 운영자의 Discord 사용자 ID. 대시보드 운영자 패널·/system 접근 권한 (비우면 아무도 접근 불가)
SESSION_SECRET=          # 세션 쿠키 서명 비밀 - 최소 64자 이상 랜덤 문자열 권장 (비우면 기동마다 랜덤 생성 = 재시작 시 대시보드 로그인 풀림)

# 대시보드 요청 제한 - 사용자(로그인 전에는 IP)별로 셉니다. 정상 사용에서 걸리면 늘리세요
RATE_LIMIT_WINDOW_SEC=60      # 아래 두 값을 세는 구간 (초)
RATE_LIMIT_API_MAX=120        # 구간당 일반 API 요청 수 (실시간 갱신 연결은 세지 않음)
RATE_LIMIT_QUEUE_MAX=20       # 구간당 곡 추가 요청 수. 추가는 yt-dlp를 부르므로 따로 조입니다
RATE_LIMIT_AUTH_WINDOW_SEC=600 # 로그인 시도를 세는 구간 (초)
RATE_LIMIT_AUTH_MAX=30        # 그 구간당 로그인/OAuth 요청 수

# 오디오 캐시 설정
CACHE_MAX_SIZE_MB=1024           # 캐시 최대 용량 (MB)
CACHE_MAX_FILES=500              # 캐시 최대 파일 수
CACHE_MIN_FREE_DISK_MB=2048      # 디스크 최소 여유 공간 (MB) - 이 미만이면 강제 퇴거
CACHE_EVICT_INTERVAL_HOURS=4     # 주기적 정리 간격 (시간)

# 재생 스트림 청크 크기
#   유튜브 오디오를 이 크기씩 나눠 받아 메모리에 두고 재생합니다. 스트림 하나당 약 1.25배를 씁니다.
#   클수록 요청이 줄고 연결이 끊겼을 때 버틸 여유가 커지며, 작을수록 메모리를 덜 씁니다.
STREAM_CHUNK_KB=1024        # 청크 한 개당 크기(KB) - 1024KB면 약 1분 분량 (권장값: 256~4096)

# 로그 (로그 레벨: trace < debug < info < warn < error < fatal)
LOG_LEVEL=info           # 설정값 이상의 로그만 기록합니다 (예: info면 info·warn·error·fatal)
LOG_CONSOLE_LEVEL=       # 터미널 표시값에만 적용되며, LOG_LEVEL보다 높은 값이어야 합니다. 비우면 LOG_LEVEL을 따릅니다.
LOG_FILE_ENABLED=false   # true로 하면 로그를 파일로 저장합니다.
LOG_FILE=logs/bot.log    # 로그 파일 저장 경로. 상대경로는 프로젝트 루트 기준.
LOG_FILE_MAX_MB=20       # 이 크기가 되면 기존 내용을 별개 파일로 분리합니다. (기본값: 20, 0이면 단일 파일로 작성)
LOG_FILE_KEEP=5          # 로그 파일을 몇개까지 보존할지. 초과시 오래된 것 부터 지웁니다. (기본값: 5, 0이면 삭제 없음)

